# ─── Required ─────────────────────────────────────────────────────────────────

# Your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Shared secret between this service and Salesforce Named Credential
# Generate with: openssl rand -hex 32
SERVICE_API_KEY=your-strong-random-secret-here

# ─── Optional ─────────────────────────────────────────────────────────────────

# Port to listen on (default: 3000)
PORT=3000

# Claude model to use for computer-use
# Options: claude-opus-4-8, claude-sonnet-4-6, claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# Max concurrent test sessions (default: 5)
MAX_CONCURRENT_SESSIONS=5

# Log level: info (default) | debug (verbose, includes action details)
LOG_LEVEL=info
